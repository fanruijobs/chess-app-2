# DeepSeek API key for LLM explanations of turning points (optional)
DEEPSEEK_API_KEY=

# Path to the Stockfish binary (defaults to /opt/homebrew/bin/stockfish)
STOCKFISH_PATH=

# User-Agent for chess.com API requests — include a contact (chess.com staff ask for it)
CHESS_COM_USER_AGENT=chess-app/0.1 (contact: user@example.com)
